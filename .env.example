# Database — khớp default của docker-compose.yml và application.yml (D-0-10)
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=changeme

# Redis — khớp default của docker-compose.yml và application.yml (D-0-10)
REDIS_PASSWORD=changeme_redis

# Backend
SPRING_PROFILES_ACTIVE=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=changeme
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT & admin seed — Phase 1 (D-1-08/D-1-09)
# - Chỉ cần set thật khi chạy production/không qua spring-boot:run;
#   `./mvnw spring-boot:run` đã có default dev ở profile local.
# - Hash BCrypt chứa ký tự $:
#   + Khi `source .env` trong shell: bọc single quote (như mẫu) — nếu không $2a bị mở rộng.
#   + Khi docker-compose interpolate: escape thành $$ (nếu có đưa biến này vào compose file).
JWT_SECRET='dev-only-jwt-secret-key-at-least-32-bytes-long-000'
ADMIN_PASSWORD_HASH='$2a$10$HYBypW3CZAb8hg7uH5MoZej.Mkk0dp7emjquouW0FwD0ES6E9YdWy'
